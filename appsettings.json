{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minio_admin",
    "SecretKey": "admin123",
    "BucketName": "cvs"
  },
  "PythonApi": {
    "BaseUrl": "http://127.0.0.1:5248",
    "PredictEndpoint": "/predict",
    "MatchEndpoint": "/match",
    "TimeoutSeconds": 30
  },
  "Threshold": {
    "MinMatchingScore": 0.70,
    "MinClassificationScore": 0.75
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=${DB_HOST},${MSSQL_PORT};Database=${DB_NAME};User Id=${DB_USER};Password=${MSSQL_PASSWORD};TrustServerCertificate=True"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByExcluding",
                "Args": { "expression": "LogType = 'Audit'" }
              }
            ],
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "logs/dev/ms-filtrage-ia_dev-.json",
                  "rollingInterval": "Day",
                  "retainedFileCountLimit": 3,
                  "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
                }
              }
            ]
          }
        }
      },
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByIncludingOnly",
                "Args": { "expression": "LogType = 'Audit'" }
              }
            ],
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "logs/audit/ms-filtrage-ia_audit-.json",
                  "rollingInterval": "Day",
                  "retainedFileCountLimit": 1,
                  "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
                }
              }
            ]
          }
        }
      }
    ]
  }
}